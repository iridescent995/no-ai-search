{
  "manifest_version": 3,
  "name": "NoAI Search \u2014 Hide Google AI Overviews",
  "version": "1.1.0",
  "description": "Clear your Google Search. Hide Google AI Overviews with one toggle while keeping regular search results. No tracking.",
  "minimum_chrome_version": "105",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.in/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*",
        "https://www.google.es/search*",
        "https://www.google.it/search*",
        "https://www.google.co.jp/search*",
        "https://www.google.com.br/search*"
      ],
      "css": [
        "hide-overview.css"
      ],
      "js": [
        "hide-overview.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NoAI Search \u2014 Clear your Google Search",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
